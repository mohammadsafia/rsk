# Copy to .env.local. Server values stay on the server; only NEXT_PUBLIC_* reach the browser.

# This app's public URL (canonical links, emails). Sign-in also accepts requests from this origin, for proxies that
# rewrite Host without sending X-Forwarded-Host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your API. Sign-in posts to ${API_URL}/auth/login from the server, never from the browser.
API_URL=http://localhost:4000

# Seals the session cookie. Required: generate one with `openssl rand -hex 32`. Never commit it.
SESSION_SECRET=

# Sign in against the built-in demo account instead of the API. Defaults to true in development, false in production.
AUTH_MOCK=
